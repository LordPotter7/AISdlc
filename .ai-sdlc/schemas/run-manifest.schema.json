{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://aisdlc.dev/schemas/run-manifest.schema.json", "title": "AI SDLC Model Run Manifest", "type": "object", "additionalProperties": true,
  "required": ["eval_id", "verification_class", "dataset", "dataset_hash", "runs", "model_id", "prompt_version", "prompt_hash", "temperature", "source_commit", "captured_by", "captured_at", "result"],
  "properties": {"schema_version": {"type": "integer", "minimum": 0, "description": "Record schema generation. Absent means 0: a record written before schema versioning existed."}, "eval_id": {"type": "string", "pattern": "^EVAL-[0-9]{3,}$"}, "verification_class": {"enum": ["S", "J", "N"]}, "dataset": {"type": "string"}, "dataset_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "runs": {"type": "integer", "minimum": 1}, "model_id": {"type": "string"}, "prompt_version": {"type": "string"}, "prompt_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "temperature": {"type": "number"}, "seed": {"type": ["integer", "null"]}, "source_commit": {"type": "string"}, "captured_by": {"type": "string"}, "captured_at": {"type": "string", "format": "date-time"}, "result": {"type": "object"}}
}
