{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aisdlc.dev/schemas/lesson.schema.json",
  "title": "AI SDLC Lesson",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_intent", "source_findings", "severity_of_source", "category", "status", "observation", "impact", "targets", "review_after_intents"],
  "properties": {"schema_version": {"type": "integer", "minimum": 0, "description": "Record schema generation. Absent means 0: a record written before schema versioning existed."}, 
    "id": {"type": "string", "pattern": "^LESSON-[0-9]{3,}$"},
    "source_intent": {"type": "string", "pattern": "^I[0-9]{3,}$"},
    "source_findings": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F-[0-9]{3,}$"}},
    "severity_of_source": {"enum": ["critical", "high", "medium", "low"]},
    "category": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "rejected", "accepted", "implemented", "active", "measured", "retired"]},
    "observation": {"type": "string", "minLength": 1},
    "impact": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "artifact", "enforcement", "fires_at"],
        "properties": {
          "type": {"enum": ["regression_eval", "policy", "checklist", "heuristic", "threat"]},
          "artifact": {"type": "string", "minLength": 1},
          "trigger": {"type": "string"},
          "enforcement": {"enum": ["blocking", "advisory"]},
          "fires_at": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rule": {"type": "string"},
          "stride": {"enum": ["spoofing", "tampering", "repudiation", "information_disclosure", "denial_of_service", "elevation_of_privilege"], "description": "S3.4: required for a threat target."},
          "promoted_cases": {"type": ["integer", "array"]}
        }
      }
    },
    "verification_of_lesson": {"type": "string"},
    "review_after_intents": {"type": "integer", "minimum": 1},
    "last_fired_intent": {"type": "integer", "minimum": 0},
    "fire_count": {"type": "integer", "minimum": 0}
  }
}
