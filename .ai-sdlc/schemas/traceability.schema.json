{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://aisdlc.dev/schemas/traceability.schema.json", "title": "AI SDLC Traceability", "type": "object", "additionalProperties": false,
  "required": ["intent_id", "generated_at", "generated_by", "links", "reverse_links"],
  "properties": {"decision_links": {"type": "array", "items": {"type": "object", "required": ["decision", "tasks"], "properties": {"decision": {"type": "string"}, "title": {"type": ["string", "null"]}, "status": {"type": ["string", "null"]}, "content_hash": {"type": "string"}, "requirements": {"type": "array", "items": {"type": "string"}}, "tasks": {"type": "array", "items": {"type": "string"}}}}}, "decision_reverse_links": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}, "schema_version": {"type": "integer", "minimum": 0, "description": "Record schema generation. Absent means 0: a record written before schema versioning existed."}, "intent_id": {"type": "string"}, "generated_at": {"type": "string", "format": "date-time"}, "generated_by": {"const": "runner"}, "links": {"type": "array", "items": {"type": "object", "required": ["requirement", "acceptance_criteria", "verification_classes", "tasks", "artifacts", "checks", "evidence", "status"], "properties": {"requirement": {"type": "string"}, "acceptance_criteria": {"type": "array", "items": {"type": "string"}}, "verification_classes": {"type": "array", "items": {"enum": ["D", "S", "J", "N"]}}, "tasks": {"type": "array", "items": {"type": "string"}}, "artifacts": {"type": "array", "items": {"type": "string"}}, "checks": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["planned", "verified", "deferred"]}}}}, "reverse_links": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}}}
}
