{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://aisdlc.dev/schemas/finding.schema.json", "title": "AI SDLC Finding", "type": "object", "additionalProperties": false,
  "required": ["id", "severity", "status", "source", "description", "evidence", "impact", "recommended_action", "introduced_stage", "detected_stage"],
  "properties": {"schema_version": {"type": "integer", "minimum": 0, "description": "Record schema generation. Absent means 0: a record written before schema versioning existed."}, "id": {"type": "string", "pattern": "^F-[0-9]{3,}$"}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "status": {"enum": ["open", "resolved", "accepted", "escalated"]}, "source": {"type": "string"}, "requirement": {"type": "string"}, "acceptance_criteria": {"type": "array", "items": {"type": "string"}}, "description": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}, "impact": {"type": "string"}, "recommended_action": {"type": "string"}, "introduced_stage": {"type": "integer", "minimum": 0, "maximum": 6}, "detected_stage": {"type": "integer", "minimum": 0, "maximum": 6}, "lesson_ref": {"type": "string"}, "repeat": {"type": "boolean"}}
}
